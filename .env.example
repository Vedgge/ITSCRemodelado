# ============================================================================
# ITSC — environment configuration.  Copy to .env and fill in real values.
# .env is gitignored.  ProdConfig REFUSES TO BOOT if any secret is missing or
# left at a placeholder value — failing fast beats silently booting insecure.
# ============================================================================

# Which config class create_app() loads: development | testing | production
FLASK_ENV=development

# --- Secrets -----------------------------------------------------------------
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-one
# Pepper for HMAC-hashing contact-form IPs (abuse tracing without storing IPs)
IP_HASH_PEPPER=change-me-generate-a-real-one

# --- Database ----------------------------------------------------------------
POSTGRES_USER=itsc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itsc
DATABASE_URL=postgresql+psycopg://itsc:change-me@db:5432/itsc
# Used only by the test suite (a separate, disposable database)
DATABASE_URL_TEST=postgresql+psycopg://itsc:change-me@localhost:55432/itsc_test

# --- Redis (sessions + rate limiting) ---------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# --- Site --------------------------------------------------------------------
SERVER_NAME=localhost:8000
PREFERRED_URL_SCHEME=http
# Portfolio disclaimer + noindex. Keep true unless this becomes an official site.
SITE_IS_PORTFOLIO_DEMO=true
SITE_OFFICIAL_URL=https://www.institutotecnicocordoba.com

# --- Uploads -----------------------------------------------------------------
# Absolute path, OUTSIDE static/. A Docker volume in production.
UPLOAD_ROOT=/srv/uploads
MAX_UPLOAD_MB=5

# --- Email (optional; contact messages persist to the DB regardless) ---------
# Leave MAIL_SERVER empty to disable sending. Delivery is best-effort by design:
# the database row is the source of truth, so a mail outage never drops a message.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CONTACT_NOTIFY_TO=

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
